# Copia este archivo como .env y llena los valores. NUNCA subas el .env a git.

# MongoDB Atlas (debe ser réplica para usar transacciones; Atlas siempre lo es)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster.mongodb.net/vetshop?retryWrites=true&w=majority

# Secreto para firmar los JWT: cadena larga y aleatoria (p. ej. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=

# Orígenes que pueden llamar a la API desde el navegador, separados por comas
CORS_ORIGINS=http://localhost:5173
# Dirección pública del frontend (se imprime en el ticket para la autofactura). Si falta, se usa el primer CORS_ORIGINS.
FRONTEND_URL=

NODE_ENV=development
PORT=5000

# Archivos de recetas (fotos/escaneos). local = carpeta en disco (solo desarrollo).
# vercel_blob = pendiente de configurar (requiere BLOB_READ_WRITE_TOKEN).
ALMACENAMIENTO=local

# Facturación CFDI 4.0. simulado = timbra de prueba sin validez fiscal (desarrollo y capacitación).
# facturapi = Facturapi con FACTURAPI_KEY (usa la clave de pruebas sk_test_… hasta cargar el CSD real).
FACTURACION_PAC=simulado
FACTURAPI_KEY=
# Datos del emisor para el PAC simulado y la representación impresa (en Facturapi se toman de la organización)
FACTURA_EMISOR_RFC=
FACTURA_EMISOR_NOMBRE=
FACTURA_EMISOR_REGIMEN=601
FACTURA_LUGAR_EXPEDICION=63000
