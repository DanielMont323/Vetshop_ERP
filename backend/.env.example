# Copia este archivo como .env y llena los valores. NUNCA subas el .env a git.

# MongoDB Atlas (debe ser réplica para usar transacciones; Atlas siempre lo es)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster.mongodb.net/vetshop?retryWrites=true&w=majority

# Secreto para firmar los JWT: cadena larga y aleatoria (p. ej. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=

# Orígenes que pueden llamar a la API desde el navegador, separados por comas
CORS_ORIGINS=http://localhost:5173

NODE_ENV=development
PORT=5000

# Archivos de recetas (fotos/escaneos). local = carpeta en disco (solo desarrollo).
# vercel_blob = pendiente de configurar (requiere BLOB_READ_WRITE_TOKEN).
ALMACENAMIENTO=local
